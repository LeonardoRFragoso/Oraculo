FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (psycopg2 needs libpq)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (layer cache)
COPY backend/requirements.prod.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./

# Create data directories
RUN mkdir -p /dados/catalog /dados/alerts /dados/reports /dados/graphs /dados/vector_store /logs

# Non-root user
RUN adduser --disabled-password --gecos "" oraculo
RUN chown -R oraculo:oraculo /app /dados /logs
USER oraculo

EXPOSE 5000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "5000", "--workers", "2"]
