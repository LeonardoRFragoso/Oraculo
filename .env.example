# ──────────────────────────────────────────────────────────────────────────────
# Oráculo API — Environment Variables
# Copie para .env e preencha os valores antes de iniciar.
# NUNCA commite o arquivo .env no repositório.
# ──────────────────────────────────────────────────────────────────────────────

# ── Aplicação ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Segurança (OBRIGATÓRIO) ───────────────────────────────────────────────────
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── LLM (pelo menos um é obrigatório) ─────────────────────────────────────────
# Defina LLM_PROVIDER=opencode para forçar o uso do OpenCode Zen.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Z.AI (OpenAI-compatible, endpoint https://api.z.ai/api/paas/v4)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ── PostgreSQL (obrigatório em produção) ──────────────────────────────────────
POSTGRES_DB=oraculo
POSTGRES_USER=oraculo
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://oraculo:senha@localhost:5432/oraculo

# ── Redis (cache e filas) ─────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:senha@localhost:6379/0

# ── Diretório de dados ────────────────────────────────────────────────────────
DATA_DIR=../dados
